{
  "name": "@midnight-authenticator/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@midnight-authenticator/contracts": "workspace:*",
    "@midnight-authenticator/core": "workspace:*",
    "hash-wasm": "^4.12.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.0.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^2.2.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
