/**
 * TOTP Verifier Contract
 *
 * Zero-knowledge TOTP authentication for Midnight blockchain.
 * Uses persistentHash (ZK-friendly) instead of HMAC-SHA1 (not available).
 *
 * Protocol:
 * 1. Registration: User commits hash(secret, blinder) on-chain
 * 2. Authentication: User proves knowledge of secret without revealing it
 *
 * NOT RFC 6238 compatible - this is a new ZK-native protocol.
 */

pragma language_version >= 0.20;

import CompactStandardLibrary;

// On-chain state
export ledger registeredAccounts: Map<Bytes<32>, Bytes<32>>; // accountId -> commitment
export ledger usedNonces: Map<Bytes<32>, Uint<64>>;          // accountId -> lastNonce
export ledger round: Counter;                                 // Privacy counter
export ledger authCount: Counter;                             // Analytics

// Witnesses - provide private data
witness getSecret(): Bytes<32>;
witness getBlinder(): Bytes<32>;
witness getCurrentTimeWindow(): Uint<64>;

/**
 * Register a new account with commitment.
 * commitment = persistentCommit(secret, blinder)
 */
export circuit registerAccount(accountId: Bytes<32>, commitment: Bytes<32>): [] {
  assert(!registeredAccounts.member(disclose(accountId)), "Account already registered");

  registeredAccounts.insert(disclose(accountId), disclose(commitment));
  round.increment(1);
}

/**
 * Authenticate by proving knowledge of secret.
 * Returns true if authentication succeeds.
 */
export circuit authenticate(accountId: Bytes<32>, nonce: Uint<64>): Boolean {
  // Get private inputs
  const secret = getSecret();
  const blinder = getBlinder();
  const timeWindow = getCurrentTimeWindow();

  // Verify commitment matches registered account
  assert(registeredAccounts.member(disclose(accountId)), "Account not registered");
  const storedCommitment = registeredAccounts.lookup(disclose(accountId));
  const computedCommitment = persistentCommit<Bytes<32>>(secret, blinder);
  assert(computedCommitment == storedCommitment, "Invalid secret");

  // Replay protection: nonce must be greater than last used
  const lastNonce = usedNonces.member(disclose(accountId))
    ? usedNonces.lookup(disclose(accountId))
    : (0 as Uint<64>);
  assert(disclose(nonce) > lastNonce, "Nonce already used");
  usedNonces.insert(disclose(accountId), disclose(nonce));

  // Compute auth code (proves knowledge, never disclosed)
  // This is the ZK magic - we prove we can compute the code without revealing it
  const _authCode = persistentHash<[Bytes<32>, Uint<64>]>([secret, timeWindow]);

  // Update counters
  round.increment(1);
  authCount.increment(1);

  return disclose(true);
}

/**
 * Pure circuit for client-side auth code computation.
 * Used by extension to display the 6-digit code to user.
 */
export pure circuit computeAuthCode(secret: Bytes<32>, timeWindow: Uint<64>): Bytes<32> {
  return persistentHash<[Bytes<32>, Uint<64>]>([secret, timeWindow]);
}

/**
 * Check if an account is registered.
 */
export circuit isRegistered(accountId: Bytes<32>): Boolean {
  return disclose(registeredAccounts.member(disclose(accountId)));
}
